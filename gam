<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>لعبة بسيطة</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background: #1e1e2e;
      color: #fff;
      margin: 0;
      padding: 20px;
    }
    #gameArea {
      position: relative;
      width: 600px;
      height: 400px;
      margin: 20px auto;
      background: #2a2a3e;
      border: 2px solid #555;
      border-radius: 10px;
      overflow: hidden;
    }
    #box {
      position: absolute;
      width: 60px;
      height: 60px;
      background: #ff6b6b;
      border-radius: 10px;
      cursor: pointer;
      transition: 0.1s;
      display: none;
    }
    #score {
      font-size: 24px;
      margin-top: 10px;
    }
    button {
      padding: 10px 20px;
      font-size: 18px;
      cursor: pointer;
      border-radius: 8px;
      border: none;
      background: #4ecdc4;
      color: #000;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>🎮 لعبة اضغط بسرعة</h1>
  <p>اضغط على المربع الأحمر قبل ما يختفي!</p>
  <button id="startBtn">ابدأ اللعبة</button>
  <div id="gameArea">
    <div id="box"></div>
  </div>
  <div id="score">النقاط: 0</div>

  <script>
    const box = document.getElementById("box");
    const gameArea = document.getElementById("gameArea");
    const scoreEl = document.getElementById("score");
    const startBtn = document.getElementById("startBtn");

    let score = 0;
    let gameRunning = false;
    let timer;

    function moveBox() {
      const maxX = gameArea.clientWidth - box.clientWidth;
      const maxY = gameArea.clientHeight - box.clientHeight;
      const x = Math.random() * maxX;
      const y = Math.random() * maxY;
      box.style.left = x + "px";
      box.style.top = y + "px";
      box.style.display = "block";

      // المربع يختفي بعد ثانية إذا لم يتم الضغط عليه
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (gameRunning) {
          box.style.display = "none";
          // إعادة ظهوره بعد فترة قصيرة
          setTimeout(() => {
            if (gameRunning) moveBox();
          }, 500);
        }
      }, 1000);
    }

    box.addEventListener("click", () => {
      if (!gameRunning) return;
      score++;
      scoreEl.textContent = "النقاط: " + score;
      box.style.display = "none";
      clearTimeout(timer);
      moveBox();
    });

    startBtn.addEventListener("click", () => {
      score = 0;
      scoreEl.textContent = "النقاط: 0";
      gameRunning = true;
      startBtn.textContent = "اللعبة شغالة...";
      startBtn.disabled = true;
      moveBox();

      // مدة اللعبة 30 ثانية
      setTimeout(() => {
        gameRunning = false;
        box.style.display = "none";
        startBtn.textContent = "العب تاني";
        startBtn.disabled = false;
        alert("خلصت اللعبة! نقاطك: " + score);
      }, 30000);
    });
  </script>
</body>
</html>